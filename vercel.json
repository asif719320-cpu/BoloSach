{
  "functions": {
    "api/og.ts": {
      "includeFiles": "api/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "c" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|facebot|meta-externalagent|Meta-ExternalAgent|facebookcatalog|WhatsApp|whatsapp|Twitterbot|twitterbot|TelegramBot|Discordbot|LinkedInBot|Slackbot|Pinterest|Applebot|Embedly|vkShare|Snapchat).*"
        }
      ],
      "destination": "/api/share"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
